{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "opensearch": {
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "memoryLimit": { "type": "string" },
        "storage": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 1 },
        "auth": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" }
          }
        }
      }
    }
  }
}
